---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, platform } from '../data/site';
---
<BaseLayout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">PI-CONTROL LAB</p>
      <h1 id="hero-title">PICO-Humanoid</h1>
      <p class="hero-expansion">{site.expansion}</p>
      <p class="hero-lead">人形机器人研究平台</p>
      <p class="hero-description">由 PI-Control Lab 自主研发，围绕机械、电子、固件与控制软件开展平台建设与研究。</p>
      <div class="actions"><a class="button button-primary" href="/guides/">开始使用<Icon name="arrow-right" /></a><a class="button button-secondary" href="/about/team/">关于我们</a></div>
    </div>
    <div class="hero-brand" aria-label="PICO 品牌标志">
      <div class="brand-grid" aria-hidden="true"></div>
      <img src="/assets/PICO.png" alt="PICO Logo" width="180" height="180" fetchpriority="high" />
      <span>PREDICTIVE · INTELLIGENT · CONTROLLED</span>
    </div>
  </section>
  <section class="platform-section" id="platform" aria-labelledby="platform-title">
    <div class="container">
      <div class="section-heading" data-reveal><div><p class="eyebrow">THE PLATFORM</p><h2 id="platform-title">平台技术</h2></div><p>从机构设计到控制软件</p></div>
      <div class="platform-grid">{platform.map((item, index) => <a class="platform-card" href={item.href} data-reveal style={`--reveal-delay: ${index * 20}ms`}><Icon name={item.icon} class="platform-icon" /><h3>{item.title}</h3><p>{item.description}</p><span class="card-link">了解更多<Icon name="arrow-right" /></span></a>)}</div>
    </div>
  </section>
  <section class="research-section container" aria-labelledby="research-title" data-reveal><div><p class="eyebrow">RESEARCH</p><h2 id="research-title">研究成果</h2><p>相关论文与研究资料持续整理中。</p></div><a class="text-link" href="/research/publications/">相关论文<Icon name="arrow-right" /></a></section>
</BaseLayout>
