---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="页面未找到" description="该页面不存在，请返回 PICO-Humanoid 首页继续浏览。" noindex>
  <section class="not-found container"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1>页面未找到</h1><p>该地址可能已变更，或者页面尚未建立。</p><a class="button button-primary" href="/">返回首页<Icon name="arrow-right" /></a></section>
</BaseLayout>
